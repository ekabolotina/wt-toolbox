{
  "manifest_version": 3,
  "name": "WT Toolbox",
  "version": "1.3.0",
  "description": "Dev-инструмент для тестирования PR на разных стендах WT. Переключает номер PR через cookie.",
  "permissions": ["storage", "declarativeNetRequest", "webRequest", "activeTab", "scripting"],
  "host_permissions": ["https://invest.alfabank.ru/*", "https://invest-test.alfabank.ru/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "icons": {
    "16": "src/icons/icon16.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}
